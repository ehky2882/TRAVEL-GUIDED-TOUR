source "https://rubygems.org"

# The release toolchain.
#
# Pinning fastlane here is what makes a cloud Mac and your own Mac run the SAME
# release process rather than "whatever happened to be installed on that
# machine". After the first successful `bundle install`, commit the generated
# Gemfile.lock — that is what turns "should be the same" into "is the same".
gem "fastlane", ">= 2.220"
