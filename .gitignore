.DS_Store

# Claude Code background-agent worktrees (transient; auto-cleaned)
.claude/worktrees/

# duplicate-image check download cache (scripts/check-image-duplicates.py)
.cache/

# --- release toolchain (fastlane) ---
# Signing keys must never be committed.
*.p8
.env
.env.*

# Build output.
build/
*.ipa
*.xcarchive
*.dSYM.zip

# fastlane run artefacts.
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
fastlane/README.md

# Captured screenshots are regenerated on demand and are large binaries; the
# reviewed set is uploaded to App Store Connect rather than stored in git.
fastlane/screenshots/**/*.png
fastlane/screenshots/**/*.jpg

# Python bytecode from repo scripts
__pycache__/
*.pyc

# --- web/ (Next.js landing site) ---
# Dependencies and build output: ~550 MB, regenerated by `npm install` / `next build`.
# Untracked and unignored, these were one stray `git add -A` away from being
# committed permanently.
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts
web/*.tsbuildinfo

# Belt-and-braces for any future JS project in the repo.
node_modules/
.next/
