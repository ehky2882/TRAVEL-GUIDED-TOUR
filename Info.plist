<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDisplayName</key>
	<string>Dozent</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.ehky.TRAVEL-GUIDED-TOUR.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dozent</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAccentColorName</key>
	<string>AccentColor</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Dozent uses your location while the app is in the background so tour stops can trigger automatically as you walk between them.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Dozent uses your location to surface audio tours near you and trigger stop-by-stop audio when you arrive at a stop.</string>
	<key>NSCameraUsageDescription</key>
	<string>Dozent uses the camera to scan a friend's code so you can join their group and listen to a tour together.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Dozent uses the microphone so you can record narration for the audio tours you create.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Dozent turns your recorded narration into a transcript on this device, so you can correct it instead of typing it out. The audio is not sent anywhere.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Dozent uses the local network to sync audio with people near you when you listen to a tour together.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_atlas-tour._tcp</string>
		<string>_atlas-tour._udp</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UISupportedInterfaceOrientations~iphone</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
